{
  "name": "java-test-executor",
  "version": "1.0.0",
  "description": "Compiles and runs Java unit tests (JUnit/TestNG) with coverage and static analysis via Maven/Gradle",
  "main": "java_test_service.js",
  "scripts": {
    "start": "node java_test_service.js",
    "test": "jest --config ../jest.config.cjs --coverage --verbose --forceExit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0"
}
